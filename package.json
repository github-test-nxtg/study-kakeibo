{
  "name": "kakeibo-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "家計簿アプリ試作品（React + TypeScript）。Electron + SQLite への移行を前提とした構成。",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/domain.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/domain.test.mjs --log-level=warning && node --test .test-dist/domain.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run check && playwright test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
